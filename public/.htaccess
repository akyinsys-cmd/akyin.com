# ==============================================================================
# AKYIN.COM — Hostinger / Apache / LiteSpeed Production SPA Configuration
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Block direct HTTP access to hidden dotfiles (excluding .well-known) and config/source files
<FilesMatch "(^\.(?!well-known)|^package(-lock)?\.json$|^tsconfig\.json$|^bun\.lockb?$|^server\.(ts|js)$|^metadata\.json$|\.env)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS redirection (recommended for production https://akyin.com)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(www\.)?akyin\.com$ [NC]
  RewriteRule ^ https://akyin.com%{REQUEST_URI} [L,R=301]

  # Allow direct access to .well-known (MCP server-card, etc.) and agent files
  RewriteRule ^\.well-known/ - [L]
  RewriteRule ^(robots\.txt|llms\.txt|sitemap\.xml)$ - [L]

  # Deny hidden paths outside .well-known
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Serve Markdown (llms.txt) when an AI agent explicitly sends Accept: text/markdown
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{REQUEST_URI} !^/(assets|src)/ [NC]
  RewriteRule ^ /llms.txt [L,T=text/markdown]

  # Direct access to actual files or directories
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # Single Page Application (SPA) routing fallback to index.html
  RewriteRule . /index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(self), payment=(self \"https://checkout.razorpay.com\")"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# MIME Types for Modern Web Assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/pdf .pdf
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Caching for Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
